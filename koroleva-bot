import os
from telegram import InlineKeyboardButton, InlineKeyboardMarkup, Update
from telegram.ext import ApplicationBuilder, CommandHandler, MessageHandler, CallbackQueryHandler, ContextTypes, filters
import aiohttp

SECRET_PASSWORD = "royalpass"
HF_TOKEN = os.getenv("HF_TOKEN")

async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    await update.message.reply_text("Привітствую! Я Королева 👑")

async def chat_with_ai(text: str):
    headers = {"Authorization": f"Bearer {HF_TOKEN}"}
    payload = {"inputs": text}
    async with aiohttp.ClientSession() as session:
        async with session.post(
            "https://api-inference.huggingface.co/models/facebook/blenderbot-400M-distill",
            headers=headers,
            json=payload
        ) as response:
            data = await response.json()
            return data[0]["generated_text"]

async def secret_or_ai(update: Update, context: ContextTypes.DEFAULT_TYPE):
    text = update.message.text.strip()
    if text == SECRET_PASSWORD:
        keyboard = [
            [InlineKeyboardButton("Тайні знання 👑", callback_data='knowledge')],
            [InlineKeyboardButton("Секретні команди 🗡️", callback_data='commands')],
            [InlineKeyboardButton("Скарби 💎", callback_data='treasures')]
        ]
        reply_markup = InlineKeyboardMarkup(keyboard)
        await update.message.reply_text("Добро пожаловать в тайне меню:", reply_markup=reply_markup)
    else:
        reply = await chat_with_ai(text)
        await update.message.reply_text(f"Королева каже: {reply}")

async def button(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()
    if query.data == 'knowledge':
        await query.edit_message_text(text="📜 Тайні знання: будь мудрим.")
    elif query.data == 'commands':
        await query.edit_message_text(text="🗡️ Секретні команди: сила у твоїх руках.")
    elif query.data == 'treasures':
        await query.edit_message_text(text="💎 Скарби: цінність у знанні.")

def main():
    TOKEN = os.getenv("BOT_TOKEN")
    app = ApplicationBuilder().token(TOKEN).build()

    app.add_handler(CommandHandler("start", start))
    app.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, secret_or_ai))
    app.add_handler(CallbackQueryHandler(button))

    # Використовуємо webhook замість polling
    app.run_webhook(
        listen="0.0.0.0",
        port=int(os.getenv("PORT", "8080")),
        url_path=TOKEN,
        webhook_url=f"https://{os.getenv('RAILWAY_STATIC_URL')}/{TOKEN}"
    )


if __name__ == "__main__":
    main()
