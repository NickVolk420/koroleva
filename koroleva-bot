async def button(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()
    if query.data == 'knowledge':
        await query.edit_message_text(text="📜 Тайные знания: будь мудр и осторожен.")
    elif query.data == 'commands':
        await query.edit_message_text(text="🗡️ Секретные команды: сила в твоих руках.")
    elif query.data == 'treasures':
        await query.edit_message_text(text="💎 Сокровища: ценность скрыта в знании.")

def main():
    TOKEN = os.getenv("BOT_TOKEN")
    app = ApplicationBuilder().token(TOKEN).build()

    app.add_handler(CommandHandler("start", start))
    app.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, secret))
    app.add_handler(CallbackQueryHandler(button))

    app.run_polling()

if __name__ == "__main__":
    main()
